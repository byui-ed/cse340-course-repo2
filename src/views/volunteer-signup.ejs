<%- include('partials/header') %>

<main class="form-container">
    <h1>Volunteer Sign-Up for <%= project.title %></h1>
    <p class="subtitle">Join as a volunteer with <strong><%= project.organization_name || 'our organization' %></strong>.</p>

    <form action="/project/<%= project.project_id %>/volunteer" method="POST" class="volunteer-form card">
        
        <!-- Personal Information -->
        <fieldset>
            <legend>Personal Details</legend>

            <div class="form-group">
                <label for="fullName">Full Name *</label>
                <input 
                    type="text" 
                    id="fullName" 
                    name="fullName" 
                    value="<%= typeof user !== 'undefined' && user ? (user.first_name + ' ' + (user.last_name || '')).trim() : '' %>" 
                    required 
                />
            </div>

            <div class="form-group">
                <label for="email">Email Address *</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    value="<%= typeof user !== 'undefined' && user ? user.email : '' %>" 
                    required 
                />
            </div>

            <div class="form-group">
                <label for="phone">Phone Number *</label>
                <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    placeholder="e.g. +234 800 000 0000" 
                    required 
                />
            </div>
        </fieldset>

        <!-- Availability & Skills -->
        <fieldset>
            <legend>Availability & Interests</legend>

            <div class="form-group">
                <label for="availability">Availability / Preferred Hours *</label>
                <select id="availability" name="availability" required>
                    <option value="" disabled selected>Select your availability</option>
                    <option value="full-day">Full Day</option>
                    <option value="morning">Morning Shift</option>
                    <option value="afternoon">Afternoon Shift</option>
                    <option value="flexible">Flexible / As Needed</option>
                </select>
            </div>

            <div class="form-group">
                <label for="skills">Skills & Expertise</label>
                <textarea 
                    id="skills" 
                    name="skills" 
                    rows="3" 
                    placeholder="e.g. Event organization, logistics, medical aid, first aid, technical support..."
                ></textarea>
            </div>

            <div class="form-group">
                <label for="notes">Additional Comments / Special Requirements</label>
                <textarea 
                    id="notes" 
                    name="notes" 
                    rows="2" 
                    placeholder="Any dietary needs, accessibility requirements, or notes..."
                ></textarea>
            </div>
        </fieldset>

        <!-- Emergency Contact -->
        <fieldset>
            <legend>Emergency Contact</legend>

            <div class="form-group">
                <label for="emergencyName">Emergency Contact Name *</label>
                <input type="text" id="emergencyName" name="emergencyName" required />
            </div>

            <div class="form-group">
                <label for="emergencyPhone">Emergency Contact Phone *</label>
                <input type="tel" id="emergencyPhone" name="emergencyPhone" required />
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Confirm & Submit Registration</button>
            <a href="/project/<%= project.project_id %>" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</main>

<%- include('partials/footer') %>