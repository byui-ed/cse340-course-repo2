<%- include('partials/header') %>

<main>
    <h1>Category: <%= category.category_name %></h1>

    <!-- Services Offered Under This Category -->
    <section class="services-section">
        <h2>Services & Work Provided in this Category</h2>
        <% if (services && services.length > 0) { %>
            <ul class="services-list">
                <% services.forEach(service => { %>
                    <li>
                        <strong><%= service.service_name %></strong>: <%= service.description %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No services currently assigned to projects in this category.</p>
        <% } %>
    </section>

    <!-- Projects Under This Category -->
    <section class="projects-section">
        <h2>Associated Projects</h2>
        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a> - <%= project.location %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No projects found for this category.</p>
        <% } %>
    </section>

    <p><a href="/categories">Back to Categories List</a></p>
</main>

<%- include('partials/footer') %>



