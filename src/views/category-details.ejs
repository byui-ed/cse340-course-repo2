<%- include('partials/header') %>

<main class="category-details-container">
    <header style="display: flex; justify-content: space-between; align-items: center;">
        <h1><%= category.category_name %> Projects</h1>

        <% if (user && user.role_name === 'admin') { %>
        <a href="/category/edit/<%= category.category_id %>" class="btn-edit">Edit Category</a>
        <% } %>
        
    </header>

    <!-- Project list section below -->
    <div class="projects-list">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <article class="project-card">
                    <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
                    <p><strong>Organization:</strong> <%= project.organization_name %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
                </article>
            <% }); %>
        <% } %>
    </div>

    <p><a href="/categories">&larr; Back to Categories</a></p>
</main>

<%- include('partials/footer') %>