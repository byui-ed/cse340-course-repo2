<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Upcoming Service Projects</h2>
    <ul>
        <% projects.forEach(project => { %>
            <li>
                <strong><%= formatDate(project.date) %>:</strong> 
                <%= project.title %> (<%= project.organization_name %>)
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>