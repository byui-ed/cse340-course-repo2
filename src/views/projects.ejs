<%- include('partials/header') %>

<main class="projects-container">
    <h1><%= title %></h1>

    <% if (user && user.role_name === 'admin') { %>
    <p><a href="/new-project" class="btn">Add New Project</a></p>
   <% } %>
   
    <div class="project-list">
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(project => { %>
                <article class="project-card" style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px; border-radius: 6px;">
                    <h2>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </h2>
                    <p><strong>Organization:</strong> <%= project.organization_name %></p>
                    <p><strong>Location:</strong> <%= project.location %></p>
                    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>

                    <!-- Embedded Services & Work Badges -->
                    <div class="services-container" style="margin-top: 10px;">
                        <strong>Work & Services Provided:</strong>
                        <% if (project.services && project.services.length > 0) { %>
                            <ul style="display: flex; gap: 8px; list-style: none; padding: 0; margin-top: 5px; flex-wrap: wrap;">
                                <% project.services.forEach(service => { %>
                                    <li style="background-color: #e9ecef; border: 1px solid #ced4da; padding: 4px 8px; border-radius: 4px; font-size: 0.9em;">
                                        <%= service.service_name %>
                                    </li>
                                <% }); %>
                            </ul>
                        <% } else { %>
                            <p style="font-style: italic; color: #6c757d;">No specific work assigned.</p>
                        <% } %>
                    </div>
                </article>
            <% }); %>
        <% } else { %>
            <p>No projects available.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>