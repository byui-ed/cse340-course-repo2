<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2>Category: <%= categoryDetails.category_name %></h2>

    <h3>Service Projects</h3>
    <% if (typeof projects !== 'undefined' && projects && projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.title %></strong>
                    </a>
                    <% if (project.organization_id && project.organization_name) { %>
                        — Partnered with: 
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    <% } %>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No service projects found for this category yet.</p>
    <% } %>
</main>
<%- include('partials/footer') %>